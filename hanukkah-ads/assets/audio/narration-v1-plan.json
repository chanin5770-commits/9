[
 {
  "line": "גננת, חנוכה שלך עומד להיראות אחרת!",
  "caption": 0.25,
  "narration_at": 0.4,
  "ends": 3.7
 },
 {
  "line": "כל מה שאת צריכה לחנוכה – במקום אחד!",
  "caption": 2.9,
  "narration_at": 3.82,
  "ends": 6.92
 },
 {
  "line": "ברוכה הבאה לעולם החנוכה!",
  "caption": 5.29,
  "narration_at": 7.04,
  "ends": 8.91
 },
 {
  "line": "עולם שלם של למידה, חוויה ואור!",
  "caption": 8.99,
  "narration_at": 9.14,
  "ends": 11.57
 },
 {
  "line": "תוכן לימודי עשיר ומוכן לגן!",
  "caption": 13.16,
  "narration_at": 13.31,
  "ends": 15.9
 },
 {
  "line": "בלי להתחיל להכין הכול מאפס!",
  "caption": 17.75,
  "narration_at": 17.9,
  "ends": 20.15
 },
 {
  "line": "סיפורים שמכניסים את הילדים לאווירת החג",
  "caption": 23.15,
  "narration_at": 23.3,
  "ends": 26.4
 },
 {
  "line": "ושירים שהופכים כל רגע לחוויה!",
  "caption": 28.3,
  "narration_at": 28.45,
  "ends": 30.98
 },
 {
  "line": "משחקים, יצירות, פעילויות",
  "caption": 32.96,
  "narration_at": 33.11,
  "ends": 35.87
 },
 {
  "line": "כל כך הרבה דרכים ללמוד וליהנות!",
  "caption": 39.06,
  "narration_at": 39.21,
  "ends": 41.73
 },
 {
  "line": "ואפילו מסיבת החנוכה כבר מחכה לך!",
  "caption": 44.23,
  "narration_at": 44.38,
  "ends": 46.88
 },
 {
  "line": "לבנים, לבנות, לגן מעורב",
  "caption": 53.44,
  "narration_at": 53.59,
  "ends": 56.53
 },
 {
  "line": "מעטפת חנוכה שלמה – באתר אחד!",
  "caption": 57.24,
  "narration_at": 57.39,
  "ends": 60.38
 },
 {
  "line": "במקום שעות של הכנות...",
  "caption": 61.16,
  "narration_at": 61.31,
  "ends": 63.32
 },
 {
  "line": "יותר זמן לילדים. יותר חוויות. יותר אור!",
  "caption": 64.21,
  "narration_at": 64.36,
  "ends": 68.31
 },
 {
  "line": "הגן שלך מוכן לחנוכה?",
  "caption": 67.51,
  "narration_at": 68.43,
  "ends": 70.22
 },
 {
  "line": "הצטרפי עכשיו לעולם החנוכה!",
  "caption": 69.91,
  "narration_at": 70.34,
  "ends": 72.62
 }
]