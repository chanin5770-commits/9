 "cues": [
  {
   "section": "s01",
   "start": 1.6,
   "end": 3.05,
   "text": "הוא עומד בצד."
  },
  {
   "section": "s01",
   "start": 4.0,
   "end": 5.93,
   "text": "רואה את כולם משחקים."
  },
  {
   "section": "s01",
   "start": 6.03,
   "end": 7.88,
   "text": "גם הוא רוצה להצטרף…"
  },
  {
   "section": "s01",
   "start": 8.23,
   "end": 10.16,
   "text": "אבל לא תמיד יודע איך."
  },
  {
   "section": "s01",
   "start": 10.81,
   "end": 12.354,
   "text": "ומיומנויות חברתיות?"
  },
  {
   "section": "s01",
   "start": 12.414,
   "end": 14.18,
   "text": "זה שריר שאפשר לאמן."
  },
  {
   "section": "s02",
   "start": 15.63,
   "end": 16.869,
   "text": "כמו שלומדים ללכת,"
  },
  {
   "section": "s02",
   "start": 16.929,
   "end": 19.32,
   "text": "גם קשר עם חברים נבנה בהדרגה."
  },
  {
   "section": "s02",
   "start": 19.42,
   "end": 22.63,
   "text": "מנסים, לפעמים מתאכזבים, ומנסים שוב."
  },
  {
   "section": "s02",
   "start": 22.73,
   "end": 25.78,
   "text": "עם ליווי, תרגול ואמונה ביכולת שלהם."
  },
  {
   "section": "s03",
   "start": 26.78,
   "end": 29.021,
   "text": "משחק משותף נותן לילדים הזדמנות"
  },
  {
   "section": "s03",
   "start": 29.081,
   "end": 31.91,
   "text": "לחכות לתור, להתפשר ולפתור מחלוקות."
  },
  {
   "section": "s03",
   "start": 32.01,
   "end": 34.561,
   "text": "כשיש פחות הזדמנויות להיפגש ולשחק,"
  },
  {
   "section": "s03",
   "start": 34.621,
   "end": 36.425,
   "text": "אפשר ליצור אותן: בגן, בבית,"
  },
  {
   "section": "s03",
   "start": 36.485,
   "end": 38.98,
   "text": "וגם במפגש עם חבר אחר הצהריים."
  },
  {
   "section": "s04",
   "start": 40.6,
   "end": 42.85,
   "text": "טבעי שנרצה לחסוך להם כאב."
  },
  {
   "section": "s04",
   "start": 42.95,
   "end": 43.911,
   "text": "אבל ברגע בטוח,"
  },
  {
   "section": "s04",
   "start": 43.971,
   "end": 46.64,
   "text": "אפשר להיות לידם ולתת להם לנסות."
  },
  {
   "section": "s04",
   "start": 46.74,
   "end": 47.518,
   "text": "להציע עזרה,"
  },
  {
   "section": "s04",
   "start": 47.578,
   "end": 50.35,
   "text": "ולעזור להם לגלות שגם הם מסוגלים."
  },
  {
   "section": "s05",
   "start": 52.85,
   "end": 54.254,
   "text": "בקבוצה לא תמיד תורי,"
  },
  {
   "section": "s05",
   "start": 54.314,
   "end": 56.86,
   "text": "ולא תמיד בוחרים במה שאני רוצה."
  },
  {
   "section": "s05",
   "start": 56.96,
   "end": 58.086,
   "text": "כשהאכזבה מגיעה,"
  },
  {
   "section": "s05",
   "start": 58.146,
   "end": 61.05,
   "text": "אפשר לתת מקום לרגש ולשמור על הגבול."
  },
  {
   "section": "s05",
   "start": 61.15,
   "end": 62.26,
   "text": "״אני רואה שקשה לך."
  },
  {
   "section": "s05",
   "start": 62.32,
   "end": 64.2,
   "text": "עכשיו מחכים. אני איתך.״"
  },
  {
   "section": "s06",
   "start": 66.7,
   "end": 68.95,
   "text": "יש ילד שאוהב קבוצה גדולה."
  },
  {
   "section": "s06",
   "start": 69.05,
   "end": 71.22,
   "text": "יש ילד שטוב לו עם חבר אחד."
  },
  {
   "section": "s06",
   "start": 71.32,
   "end": 73.57,
   "text": "ויש רגעים שנעים לשחק לבד."
  },
  {
   "section": "s06",
   "start": 74.02,
   "end": 75.051,
   "text": "נבדוק אם טוב לו,"
  },
  {
   "section": "s06",
   "start": 75.111,
   "end": 78.19,
   "text": "ואם הוא מצליח ליצור את הקשר שהוא רוצה."
  },
  {
   "section": "s07",
   "start": 80.69,
   "end": 83.34,
   "text": "גם הרגלים קטנים מתרגלים יחד:"
  },
  {
   "section": "s07",
   "start": 83.44,
   "end": 85.168,
   "text": "שוטפים ידיים אחרי יצירה,"
  },
  {
   "section": "s07",
   "start": 85.228,
   "end": 88.17,
   "text": "מחזירים משחק למקום ועוזרים בסידור."
  },
  {
   "section": "s07",
   "start": 88.27,
   "end": 90.04,
   "text": "בלי בושה ובלי לעג."
  },
  {
   "section": "s07",
   "start": 90.14,
   "end": 91.301,
   "text": "כך בונים בהדרגה"
  },
  {
   "section": "s07",
   "start": 91.361,
   "end": 93.59,
   "text": "עצמאות, אחריות והתחשבות."
  },
  {
   "section": "s08",
   "start": 96.09,
   "end": 98.02,
   "text": "חיוך יכול לפתוח קשר."
  },
  {
   "section": "s08",
   "start": 98.12,
   "end": 100.53,
   "text": "ואז מסתכלים גם על התגובה:"
  },
  {
   "section": "s08",
   "start": 100.63,
   "end": 101.989,
   "text": "האם החבר מתעניין?"
  },
  {
   "section": "s08",
   "start": 102.049,
   "end": 103.92,
   "text": "האם מתאים לו עכשיו?"
  },
  {
   "section": "s08",
   "start": 104.02,
   "end": 105.644,
   "text": "לומדים לפנות בנעימות,"
  },
  {
   "section": "s08",
   "start": 105.704,
   "end": 107.55,
   "text": "וגם לכבד תשובה אחרת."
  },
  {
   "section": "s09",
   "start": 108.6,
   "end": 110.77,
   "text": "לכל אחד יש מרחב שנעים לו."
  },
  {
   "section": "s09",
   "start": 110.87,
   "end": 112.132,
   "text": "דרך משחק בחישוקים"
  },
  {
   "section": "s09",
   "start": 112.192,
   "end": 114.48,
   "text": "אפשר להרגיש מתי קרוב לי מדי."
  },
  {
   "section": "s09",
   "start": 115.23,
   "end": 117.004,
   "text": "לומדים לשמור על הגוף שלנו"
  },
  {
   "section": "s09",
   "start": 117.064,
   "end": 119.16,
   "text": "ולכבד גם את המרחב של החבר."
  },
  {
   "section": "s10",
   "start": 121.4,
   "end": 123.49,
   "text": "ועכשיו, שוב אותה חצר."
  },
  {
   "section": "s10",
   "start": 124.04,
   "end": 126.85,
   "text": "יואב מתקרב, ועוצר לרגע להתבונן."
  },
  {
   "section": "s10",
   "start": 127.2,
   "end": 129.083,
   "text": "במה הם משחקים? מה הכללים?"
  },
  {
   "section": "s10",
   "start": 129.143,
   "end": 131.13,
   "text": "האם יש מקום לעוד חבר?"
  },
  {
   "section": "s10",
   "start": 131.58,
   "end": 133.425,
   "text": "הוא מחכה מעט, מזהה הזדמנות"
  },
  {
   "section": "s10",
   "start": 133.485,
   "end": 135.83,
   "text": "ומצטרף בדרך שמתאימה למשחק."
  },
  {
   "section": "s10",
   "start": 137.68,
   "end": 139.53,
   "text": "ואם כרגע אי אפשר?"
  },
  {
   "section": "s10",
   "start": 139.63,
   "end": 141.604,
   "text": "אפשר להמתין, לבחור משחק אחר"
  },
  {
   "section": "s10",
   "start": 141.664,
   "end": 143.4,
   "text": "או לנסות שוב בהמשך."
  },
  {
   "section": "s10",
   "start": 143.5,
   "end": 146.23,
   "text": "כל ניסיון הוא עוד הזדמנות ללמוד."
  },
  {
   "section": "s11",
   "start": 147.6,
   "end": 150.49,
   "text": "ואנחנו יכולים לתת להם מילים וכלים."
  },
  {
   "section": "s11",
   "start": 150.94,
   "end": 153.34,
   "text": "במקום רק לומר: אל תידחף —"
  },
  {
   "section": "s11",
   "start": 153.4,
   "end": 156.13,
   "text": "לעמוד מאחורי החבר ולהמתין לתור."
  },
  {
   "section": "s11",
   "start": 156.68,
   "end": 158.6,
   "text": "במקום: אל תפריע —"
  },
  {
   "section": "s11",
   "start": 158.66,
   "end": 161.39,
   "text": "להתבונן ולבדוק מתי אפשר להצטרף."
  },
  {
   "section": "s11",
   "start": 161.94,
   "end": 163.54,
   "text": "וברגע של בכי:"
  },
  {
   "section": "s11",
   "start": 163.6,
   "end": 165.031,
   "text": "״אני רואה שאתה מאוכזב."
  },
  {
   "section": "s11",
   "start": 165.091,
   "end": 167.37,
   "text": "בוא נחשוב יחד מה אפשר לעשות.״"
  },
  {
   "section": "s12",
   "start": 168.57,
   "end": 171.06,
   "text": "הם לא צריכים לדעת הכול מעצמם."
  },
  {
   "section": "s12",
   "start": 171.61,
   "end": 173.14,
   "text": "הם צריכים שנראה אותם,"
  },
  {
   "section": "s12",
   "start": 173.2,
   "end": 175.14,
   "text": "נאמין בהם ונלמד אותם."
  },
  {
   "section": "s12",
   "start": 175.79,
   "end": 179.0,
   "text": "עם אהבה, גבולות ותרגול, אפשר להתקדם."
  },
  {
   "section": "s12",
   "start": 179.85,
   "end": 181.3,
   "text": "הילד לא חייב להיוולד"
  },
  {
   "section": "s12",
   "start": 181.36,
   "end": 183.22,
   "text": "עם כל הכלים החברתיים."
  },
  {
   "section": "s12",
   "start": 183.77,
   "end": 185.7,
   "text": "הוא יכול לרכוש אותם."
  }
 ],
 "captions": [
