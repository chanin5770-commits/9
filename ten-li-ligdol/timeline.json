  "vo": [
    { "id": "v01", "at": 1.5,   "est": 3.4, "voice": "child", "text": "אמא... היום אף אחד לא שיחק איתי." },
    { "id": "v02", "at": 6.6,   "est": 1.3, "text": "חמש מילים." },
    { "id": "v03", "at": 8.4,   "est": 1.1, "text": "והלב שלך?" },
    { "id": "v04", "at": 10.2,  "est": 0.8, "text": "נשבר." },
    { "id": "v05", "at": 12.8,  "est": 2.6, "text": "כל מה שאת רוצה, זה לחבק אותו." },
    { "id": "v06", "at": 16.0,  "est": 1.3, "text": "להתקשר לגננת." },
    { "id": "v07", "at": 17.8,  "est": 1.5, "text": "לסדר לו את הכול." },
    { "id": "v08", "at": 20.4,  "est": 1.8, "text": "רק שלא יכאב לו." },
    { "id": "v09", "at": 25.8,  "est": 1.2, "text": "אבל רגע..." },
    { "id": "v10", "at": 28.0,  "est": 1.9, "text": "מה אם דווקא ברגע הזה," },
    { "id": "v11", "at": 30.2,  "est": 2.8, "text": "יש משהו חשוב שאנחנו יכולים לתת לו?" },
    { "id": "v12", "at": 34.6,  "est": 3.3, "text": "אף ילד לא נולד כשהוא יודע איך להצטרף למשחק." },
    { "id": "v13", "at": 38.4,  "est": 1.4, "text": "איך לחכות לתור." },
    { "id": "v14", "at": 41.6,  "est": 2.2, "text": "איך להתמודד כשאומרים לו לא." },
    { "id": "v15", "at": 45.2,  "est": 1.5, "text": "ואיך לנסות שוב." },
    { "id": "v16", "at": 49.2,  "est": 1.8, "text": "זוכרים כשהוא למד ללכת?" },
    { "id": "v17", "at": 52.0,  "est": 0.9, "text": "הוא נפל." },
    { "id": "v18", "at": 53.6,  "est": 1.3, "text": "והושטנו לו יד." },
    { "id": "v19", "at": 55.4,  "est": 1.8, "text": "אבל לא הלכנו במקומו." },
    { "id": "v20", "at": 57.9,  "est": 2.4, "text": "אז למה כשהוא לומד להסתדר עם חברים," },
    { "id": "v21", "at": 60.5,  "est": 2.3, "text": "אנחנו כל כך רוצים לעשות את זה בשבילו?" },
    { "id": "v22", "at": 64.0,  "est": 1.4, "text": "אפשר לשבת לידו." },
    { "id": "v23", "at": 66.0,  "est": 0.8, "text": "להקשיב." },
    { "id": "v24", "at": 67.6,  "est": 2.2, "text": "להגיד: ״אני מבינה שנפגעת.״" },
    { "id": "v25", "at": 71.0,  "est": 0.9, "text": "ואז לשאול:" },
    { "id": "v26", "at": 72.4,  "est": 2.4, "text": "״מה אתה חושב שנוכל לנסות מחר?״" },
    { "id": "v27", "at": 77.8,  "est": 3.2, "text": "כי ביטחון עצמי לא נבנה מזה שהכול תמיד מצליח." },
    { "id": "v28", "at": 81.8,  "est": 1.7, "text": "הוא נבנה כשהילד מגלה:" },
    { "id": "v29", "at": 84.4,  "est": 1.3, "text": "אני יכול לנסות." },
    { "id": "v30", "at": 86.4,  "est": 1.3, "text": "אני יכול ללמוד." },
    { "id": "v31", "at": 88.4,  "est": 1.5, "text": "אני יכול להתמודד." },
    { "id": "v32", "at": 91.6,  "est": 3.0, "text": "הילדים שלנו לא צריכים שנעלים להם כל מכשול." },
    { "id": "v33", "at": 95.4,  "est": 1.9, "text": "הם צריכים שניתן להם כלים." },
    { "id": "v34", "at": 97.8,  "est": 1.0, "text": "שנאמין בהם." },
    { "id": "v35", "at": 99.4,  "est": 2.2, "text": "ושנהיה שם כשהם צריכים אותנו." },
    { "id": "v36", "at": 103.6, "est": 1.0, "text": "כי יום אחד," },
    { "id": "v37", "at": 105.2, "est": 2.0, "text": "הם יצעדו בעולם בעצמם." },
    { "id": "v38", "at": 108.4, "est": 2.8, "text": "והמתנה הכי גדולה שנוכל לתת להם היום..." },
    { "id": "v39", "at": 112.0, "est": 2.0, "text": "היא האמונה שהם מסוגלים." }
  ],

